generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artwork {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String
  medium        String
  dimensions    String
  year          Int
  price         Int
  framedPrice   Int?
  originalPrice Int?
  description   String
  gradient      String
  imageUrl      String?
  aspectRatio   String   @default("3/4")
  badge         String?
  collection    String?
  featured      Boolean  @default(false)
  homePick      Boolean  @default(false)
  heroPick      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  @@index([category])
  @@index([collection])
  @@index([slug])
}

// Generic product for Jewellery, Clothing, Home Decor
model Product {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  type          String   // "jewellery" | "clothing" | "home-decor"
  description   String
  price         Int
  originalPrice Int?
  imageUrl      String?
  gradient      String   @default("linear-gradient(135deg, #667eea, #764ba2)")
  badge         String?  // "new" | "sold" | "featured"
  material      String?  // e.g. "Sterling Silver", "Cotton", etc.
  sizes         String?  // e.g. "S, M, L, XL" for clothing
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images ProductImage[]

  @@index([type])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  label     String? // e.g. "Front", "Back", "Side"
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Books with PDF and Amazon URL
model Book {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  author      String      @default("Chinmayi")
  description String
  price       Int?
  imageUrl    String?     // primary cover image
  pdfUrl      String?     // uploaded PDF
  amazonUrl   String?     // Amazon purchase link
  gradient    String      @default("linear-gradient(135deg, #667eea, #764ba2)")
  badge       String?     // "new" | "bestseller"
  pages       Int?
  isbn        String?
  publishYear Int?
  inStock     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  images      BookImage[]

  @@index([slug])
}

model BookImage {
  id        String @id @default(cuid())
  bookId    String
  url       String
  label     String?  // e.g. "Back cover", "Sample page", "Contents"
  sortOrder Int    @default(0)
  book      Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model Collection {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  gradient    String
  sortOrder   Int    @default(0)
  createdAt   DateTime @default(now())
}

model Order {
  id               String      @id @default(cuid())
  customerName     String
  customerEmail    String
  total            Int
  status           String      @default("pending")
  shippingAddress  String?
  paymentReference String?
  paymentMethod    String?     // e.g. "bank_transfer"
  itemsJson        String?     // JSON snapshot of cart at checkout (supports artwork, product, book)
  items            OrderItem[] // optional links to Artwork rows (legacy)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  artworkId String
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  @@index([orderId])
  @@index([artworkId])
}

model Testimonial {
  id             String @id @default(cuid())
  name           String
  role           String
  text           String
  avatar         String
  avatarGradient String
  sortOrder      Int    @default(0)
  createdAt      DateTime @default(now())
}

model SiteSettings {
  id    String @id @default("main")
  heroTitle      String @default("Where Art Meets Soul")
  heroSubtitle   String @default("Discover breathtaking original paintings and limited-edition prints.")
  artistName     String @default("Chinmayi")
  artistBio      String @default("")
  aboutImageUrl  String @default("/chinmayi-artist.jpg")
  contactEmail   String @default("chinmayi_n@yahoo.com")
  instagramUrl   String @default("")
  pinterestUrl   String @default("")
  facebookUrl    String @default("")
}

model Exhibition {
  id          String              @id @default(cuid())
  year        String
  title       String
  venue       String
  description String?
  imageUrl    String?
  videoUrl    String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  images      ExhibitionImage[]
}

model ExhibitionImage {
  id           String     @id @default(cuid())
  exhibitionId String
  url          String
  caption      String?
  sortOrder    Int        @default(0)
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  date        String
  description String
  imageUrl    String?
  location    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
